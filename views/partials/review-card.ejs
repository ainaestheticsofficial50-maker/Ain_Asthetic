<figure class="review-card reveal">
  <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
  <blockquote>“<%= r.quote %>”</blockquote>
  <figcaption>
    <img src="/img/<%= r.photo %>" alt="" loading="lazy" width="48" height="48">
    <span><strong><%= r.name %></strong><span>Verified client</span></span>
  </figcaption>
</figure>
