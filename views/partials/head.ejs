<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> | <%= site.name %></title>
  <meta name="description" content="<%= locals.description || `${site.name}, DHA Lahore. Doctor-led skin, hair, anti-ageing and laser treatments by experienced dermatologists and aesthetic physicians. Book: ${site.phones[0]}.` %>">
  <meta property="og:title" content="<%= title %> | <%= site.name %>">
  <meta property="og:image" content="<%= site.url %>/img/<%= locals.ogImage || 'posters/meet-dr-asim.jpg' %>">
  <meta property="og:description" content="<%= locals.description || site.tagline %>">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#1d2b45">
  <link rel="canonical" href="<%= site.url %><%= path === '/' ? '' : path %>">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&family=Great+Vibes&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= v %>">
  <script src="/js/head.js?v=<%= v %>"></script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: site.name,
    url: site.url,
    telephone: site.phones,
    image: site.url + '/img/posters/meet-dr-asim.jpg',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.lines.slice(0, 2).join(', '),
      addressLocality: 'Lahore',
      addressCountry: 'PK'
    },
    medicalSpecialty: ['Dermatology', 'PlasticSurgery'],
    sameAs: ['https://www.instagram.com/' + site.instagram],
    employee: site.doctors.map(d => ({ '@type': 'Physician', name: d.name, jobTitle: d.role }))
  }).replace(/</g, '\\u003c') %>
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('header') %>
<main id="main">
