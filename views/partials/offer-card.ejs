<% const t = site.treatmentBySlug[o.treatment]; %>
<article class="offer-card reveal">
  <a class="offer-media" href="/img/<%= o.poster %>" data-lightbox>
    <img src="/img/<%= o.poster %>" alt="<%= o.title %> offer poster" loading="lazy">
  </a>
  <div class="offer-body">
    <span class="badge badge-offer"><%= o.badge %></span>
    <h3><%= o.title %></h3>
    <p><%= o.text %></p>
    <p class="offer-note">Limited-time offer</p>
    <div class="offer-actions">
      <a class="btn btn-primary btn-sm" href="/contact?service=<%= encodeURIComponent(t ? t.title : '') %>">Book this offer</a>
      <a class="btn btn-ghost btn-sm" href="<%= site.waLink(`Hi, I'd like to know more about the ${o.title} offer (${o.badge}).`) %>" target="_blank" rel="noopener">Ask on WhatsApp</a>
    </div>
  </div>
</article>
