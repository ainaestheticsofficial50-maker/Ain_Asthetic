</main>

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <p class="script">Your skin, our expertise</p>
      <h2>Book your consultation today</h2>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light" href="tel:<%= site.phones[0].replace(/-/g, '') %>">Call <%= site.phones[0] %></a>
      <a class="btn btn-outline-light" href="<%= site.waLink(locals.waText || site.waDefault) %>" target="_blank" rel="noopener">WhatsApp us</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-logo" href="/" aria-label="<%= site.name %> home">
        <img src="/img/logo-white.png" alt="<%= site.name %> logo" width="377" height="277" loading="lazy">
      </a>
      <p class="footer-tag"><%= site.tagline %></p>
      <p>Doctor-led skin, hair, anti-ageing and laser care in <%= site.address.short %>.</p>
    </div>
    <div>
      <h3>Treatments</h3>
      <ul>
        <% site.categories.forEach(c => { %>
          <li><a href="/treatments#<%= c.slug %>"><%= c.title %></a></li>
        <% }) %>
        <li><a href="/offers">Current offers</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul>
        <% site.phones.forEach(p => { %>
          <li><a href="tel:<%= p.replace(/-/g, '') %>"><%= p %></a></li>
        <% }) %>
        <li><a href="<%= site.waLink() %>" target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href="https://www.instagram.com/<%= site.instagram %>" target="_blank" rel="noopener">Instagram @<%= site.instagram %></a></li>
      </ul>
    </div>
    <div>
      <h3>Visit us</h3>
      <address><%- site.address.lines.join('<br>') %></address>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <%= year %> <%= site.name %>. All rights reserved.</p>
    <p>Individual results may vary.</p>
  </div>
</footer>

<a class="wa-float" href="<%= site.waLink(locals.waText || site.waDefault) %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <%- include('whatsapp-icon', { size: 28 }) %>
</a>

<nav class="action-bar" aria-label="Quick contact">
  <a href="tel:<%= site.phones[0].replace(/-/g, '') %>">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    Call Now
  </a>
  <a class="ab-wa" href="<%= site.waLink(locals.waText || site.waDefault) %>" target="_blank" rel="noopener"><%- include('whatsapp-icon', { size: 18 }) %> Contact on WhatsApp</a>
</nav>

<script src="/js/main.js?v=<%= v %>" defer></script>
</body>
</html>
